# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# React Native Firebase (v27+) requires dynamically linked frameworks
use_frameworks! :linkage => :dynamic

target 'FieldReportingApp' do
  config = use_native_modules!

  # WatermelonDB needs the npm-vendored simdjson, not the CocoaPods one
  pod 'simdjson', path: '../node_modules/@nozbe/simdjson', modular_headers: true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # react-native-image-picker uses UTType APIs but doesn't declare the frameworks,
    # which breaks linking as a dynamic framework
    installer.pods_project.targets.each do |target|
      next unless target.name == 'react-native-image-picker'
      target.build_configurations.each do |build_config|
        build_config.build_settings['OTHER_LDFLAGS'] = ['$(inherited)', '-framework', 'UniformTypeIdentifiers', '-framework', 'MobileCoreServices']
      end
    end
  end
end
